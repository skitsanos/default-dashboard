{
  "name": "default-dashboard",
  "version": "2.1.0",
  "repository": "https://github.com/skitsanos/default-dashboard.git",
  "author": {
    "name": "skitsanos",
    "url": "https://skitsanos.com"
  },
  "license": "MIT",
  "scripts": {
    "postinstall": "umi setup",
    "dev": "umi dev",
    "build": "NODE_ENV=production umi build",
    "preview": "umi preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "deploy": "netlify deploy --prod",
    "depupdates": "npx npm-check-updates -u"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-layout": "^7.22.7",
    "ahooks": "^3.9.7",
    "antd": "^6.5.2",
    "chance": "^1.1.13",
    "dayjs": "^1.11.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "umi": "^4.6.82",
    "umi-request": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@umijs/mako": "^0.11.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@ant-design/pro-layout": {
      "antd": "$antd",
      "@ant-design/icons": "$@ant-design/icons"
    },
    "@ant-design/pro-utils": {
      "antd": "$antd",
      "@ant-design/icons": "$@ant-design/icons"
    },
    "@ant-design/pro-field": {
      "antd": "$antd",
      "@ant-design/icons": "$@ant-design/icons"
    },
    "@ant-design/pro-provider": {
      "antd": "$antd"
    }
  }
}
